<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.agent-farm.worker.@INSTANCE@</string>
  <key>ProgramArguments</key>
  <array>
    <string>@FARM_BIN@/farm-runner.sh</string>
    <string>@INSTANCE@</string>
  </array>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>15</integer>
  <key>RunAtLoad</key><true/>
  <key>EnvironmentVariables</key><dict><key>NO_COLOR</key><string>1</string></dict>
  <key>StandardOutPath</key><string>@LOG_DIR@/worker-@INSTANCE@.log</string>
  <key>StandardErrorPath</key><string>@LOG_DIR@/worker-@INSTANCE@.log</string>
  <key>WorkingDirectory</key><string>@REPO_DIR@</string>
</dict>
</plist>
