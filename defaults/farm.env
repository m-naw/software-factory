# software-factory default config. Override per project in <repo>/.agent-farm/farm.env
# Verification commands the implementer/QA run before declaring work done.
FARM_VERIFY_CMD="npm run check"
FARM_TEST_CMD="npm run test"
# Extra safety keywords beyond the generic committed set (regex fragment, word-bounded).
# Uncomment + extend for your project's safety-critical vocabulary, e.g.:
# FARM_SAFETY_KEYWORDS_RE='\b(auth|passkey|payment|billing|credential|token|secret|csrf|webhook)\b'
# QA model for tier:light tasks (resolve_qa_model). Heavy/default QA stays
# QA_MODEL (opus); tasks citing protected paths ALWAYS get opus QA (hard safety
# floor, not overridable). Committed default lives in bin/farm-lib.sh; uncomment
# here only to override.
# QA_MODEL_LIGHT=sonnet
